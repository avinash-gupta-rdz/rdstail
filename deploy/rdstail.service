# systemd unit for rdstail. Install:
#   sudo useradd --system --home /var/lib/rdstail --shell /usr/sbin/nologin rdstail
#   sudo mkdir -p /var/lib/rdstail /etc/rdstail && sudo chown rdstail: /var/lib/rdstail
#   sudo cp rdstail.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rdstail
[Unit]
Description=rdstail — RDS log shipper
Documentation=https://github.com/avinash-gupta-rdz/rdstail
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rdstail
Group=rdstail
Environment=AWS_REGION=ap-south-1
ExecStart=/usr/local/bin/rdstail run -c /etc/rdstail/config.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/rdstail

[Install]
WantedBy=multi-user.target
